root ::= r0
r0 ::= "{" ws "\"age\"" ws ":" ws integer ws "," ws "\"name\"" ws ":" ws string ws "," ws "\"ok\"" ws ":" ws boolean ws "}"
ws ::= ( " " | "\n" [ \t]{0,20} )?
null ::= "null"
boolean ::= "true" | "false"
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
string ::= "\"" char* "\""
integer ::= "-"? ( "0" | [1-9] [0-9]{0,15} )
number ::= integer ( "." [0-9]{1,16} )? ( [eE] [-+]? [0-9]{1,3} )?
