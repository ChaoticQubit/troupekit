root ::= r0
r0 ::= "{" ws "\"count\"" ws ":" ws r1 ws "," ws "\"note\"" ws ":" ws r2 ws "," ws "\"temp\"" ws ":" ws r3 ws "}"
r1 ::= "0" | [1-9] [0-9]{0,2}
r2 ::= string | null
r3 ::= ( [0-9] | "-" [1-9] [0-9]{0,1} ) ( "." [0-9]{1,16} )?
ws ::= ( " " | "\n" [ \t]{0,20} )?
null ::= "null"
boolean ::= "true" | "false"
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
string ::= "\"" char* "\""
integer ::= "-"? ( "0" | [1-9] [0-9]{0,15} )
number ::= integer ( "." [0-9]{1,16} )? ( [eE] [-+]? [0-9]{1,3} )?
